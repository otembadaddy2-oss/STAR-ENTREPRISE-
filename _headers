# Netlify — en-têtes de cache (compression gzip/brotli automatique par Netlify)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/docs/*
  Cache-Control: public, max-age=2592000

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Sécurité KOMYO : pas de lecture « devinée » des fichiers, pas d'affichage du site dans le cadre d'un autre site,
# pas de fuite de l'adresse complète vers d'autres sites, caméra et micro réservés à KOMYO (publier une vidéo).
/starvibe/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

/api/*
  X-Content-Type-Options: nosniff
  Cache-Control: no-store

# KOMYO — cache des fichiers de l'application : revisites instantanées, mises à jour en arrière-plan.
/starvibe/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/starvibe/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/starvibe/assets/video/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/starvibe/assets/audio/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/starvibe/assets/*.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/starvibe/assets/*.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/starvibe/assets/*.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
