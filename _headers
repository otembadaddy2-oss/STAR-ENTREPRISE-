# Netlify — en-têtes de cache (compression gzip/brotli automatique par Netlify)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/docs/*
  Cache-Control: public, max-age=2592000

# Page « Découvrez qui est STAR ENTREPRISE » : médias gardés 30 jours dans le téléphone du visiteur (moins de téléchargements, moins de crédits).
/decouvrir/img/*
  Cache-Control: public, max-age=2592000
/decouvrir/video/*
  Cache-Control: public, max-age=2592000
/decouvrir/polices/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Sécurité (tout le site) : pas de lecture « devinée » des fichiers, pas d'affichage du site dans le cadre d'un autre site
# (anti-« clickjacking »), pas de fuite de l'adresse complète vers d'autres sites, HTTPS forcé.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
# KOMYO : caméra et micro réservés à KOMYO (publier une vidéo).
/starvibe/*
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=()

# Passeport Sûr (démonstration pour le Ministère) : non référencé par les moteurs de recherche ; caméra réservée à l'application (scan du QR et photos).
/passeport-demo/*
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
/passeport-demo/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/passeport-demo/lib/ocr-5.1.0/*
  Cache-Control: public, max-age=31536000, immutable
/passeport-demo/polices/*
  Cache-Control: public, max-age=31536000, immutable

# Passeport Sûr — protection du navigateur : seuls les scripts de l'application elle-même s'exécutent (aucun script en ligne, aucun site tiers), et l'application ne peut parler qu'à son propre serveur.
/api/passeport
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'
/api/passeport-piece
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'
/api/*
  Cache-Control: no-store

# KOMYO — cache des fichiers de l'application : revisites instantanées, mises à jour en arrière-plan.
/starvibe/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/starvibe/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/starvibe/assets/video/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/starvibe/assets/audio/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/starvibe/assets/*.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/starvibe/assets/*.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/starvibe/assets/*.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
